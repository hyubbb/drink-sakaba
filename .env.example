# Supabase project (Settings → API). Both values are public and safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# New-style publishable key (sb_publishable_...). The legacy anon key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Phase 2 (optional): set to 1 after enabling Anonymous Sign-ins and the RLS policies
# in docs/SUPABASE_SETUP.md. Clients then sign in anonymously and join private channels.
NEXT_PUBLIC_SAKABA_PRIVATE_CHANNELS=0

# NEVER put the service_role / secret key in any NEXT_PUBLIC_ variable.

# Dev only: "local" fakes the realtime server with BroadcastChannel so two tabs in one browser can play together.
# Leave empty in production.
NEXT_PUBLIC_SAKABA_NET=
